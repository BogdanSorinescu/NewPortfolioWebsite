        background-repeat: no-repeat;
        background-size: 100% 100%;
    }

    @media (max-width: 720px) {
        body {
            background:
                radial-gradient(ellipse at 50% 0%, rgba(38, 38, 34, 0.78), rgba(6, 6, 6, 0.95) 34%, transparent 58%),
                radial-gradient(ellipse at 50% 48%, rgba(39, 180, 245, 0.38), rgba(39, 180, 245, 0.36) 30%, transparent 62%),
                linear-gradient(180deg, #030303 0%, #111111 30%, #0d3a4f 58%, #1b7fb0 80%, #27b4f5 100%),
