---
import Layout from "../layouts/Layout.astro";
import LiquidGlass from "../components/liquidGlass.jsx";
import ProjectsGlass from "../components/ProjectsGlass.jsx";
import ImageOfMe from "../assets/ImageOfMe.png";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { faGithub, faLinkedinIn } from "@fortawesome/free-brands-svg-icons";
import { faMagnifyingGlass } from "@fortawesome/free-solid-svg-icons";
---

<Layout>
    <main class="home">
        <div class="hero-content">
            <div>
                <LiquidGlass client:load>
                    <div class="hero-title-row">
                        <FontAwesomeIcon
                            icon={faMagnifyingGlass}
                            className="hero-search-icon"
                        />
                        <h1 class="hero-title">Hello, I'm Bogdan Sorinescu!</h1>
                    </div>
                </LiquidGlass>
            </div>
            <img
                class="profile-image"
                src={ImageOfMe.src}
                alt="Bogdan Sorinescu"
            />
        </div>
        <div class="InfoCard">
            <LiquidGlass
                client:load
                className="info-glass-card"
                style={{ position: "fixed", top: "48%", left: "50%" }}
                padding="42px 56px"
                cornerRadius={48}
            >
                <section class="personal-card">
                    <h2>About Me</h2>

                    <div class="card-profile">
                        <div class="avatar">BS</div>
                        <div>
                            <h3>Bogdan Sorinescu</h3>
                            <p>CS Student</p>
                        </div>
                    </div>
                    <div class="card-info">
                        <span>Email:</span>
                        <span>bogdansorinescu@gmail.com</span>

                        <span>Location:</span>
                        <span>Växjö, Sweden</span>

                        <span>Focus:</span>
                        <span>Software Developement and Ai Engineering</span>
                    </div>
                </section>
            </LiquidGlass>
        </div>
        <ProjectsGlass client:load />
        <div class="mediaIcons">
            <a href="https://github.com/BogdanSorinescu">
                <FontAwesomeIcon icon={faGithub} />
            </a>
            <a href="https://www.linkedin.com/in/bogdan-sorinescu-6b1613348/">
                <FontAwesomeIcon icon={faLinkedinIn} />
            </a>
        </div>
    </main>
</Layout>
